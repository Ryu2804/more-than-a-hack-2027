    [No 1-s merge], [352], [5.0], [0.761], [0.895],
    [Proximity gate off], [297], [6.8], [0.772], [0.901],
    [TCN only], [287], [7.4], [0.786], [0.921],
    [GRU w = 0.5], [330], [6.0], [0.700], [0.863],
    [GRU only (w = 1)], [388], [5.3], [0.566], [0.707],
    [λ fixed ½× / 2×], [306 / 284], [6.6 / 7.4], [0.772], [0.901],
